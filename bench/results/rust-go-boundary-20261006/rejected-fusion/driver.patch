+// The caller supplies the row buffer's column count, not the statement's
+// post-step count: sqlite3_step may re-prepare a statement after schema changes.
+// Text/blob pointers are borrowed until the next step/reset/finalize and must
+// be copied by Go before then.
+static int
+_sqlite3_step_values(sqlite3_stmt *stmt, int ncol, sqlite3_go_col *cols)
