#!/usr/bin/env python3
"""Compare observable HTTP workflows and stored state against pinned Rust."""

import argparse
import base64
import hashlib
import http.cookiejar
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import sqlite3
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader(
    "upgrade", str(ROOT / "bin/check-upgrade")
)
spec = importlib.util.spec_from_loader(loader.name, loader)
upgrade = importlib.util.module_from_spec(spec)
loader.exec_module(upgrade)


class App:
    def __init__(self, base, database, labels):
        self.base, self.database, self.labels = base, database, labels
        self.trace = []
        self.clients = {}

    def request(self, actor, method, path, fields=None, frame=None):
        headers = {}
        if frame:
            headers["Turbo-Frame"] = frame
        body = None
        if fields is not None:
            body = urllib.parse.urlencode(fields).encode()
            headers.update(
                {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Accept": "text/vnd.turbo-stream.html, text/html",
                }
            )
        status, destination, _, data = self.fetch(actor, method, path, body, headers)
        return status, destination, data.decode("utf-8")

    def fetch(self, actor, method, path, body=None, headers=None):
        """Consume complete binary responses while retaining actor cookies and headers."""
        if actor not in self.clients:
            self.clients[actor] = urllib.request.build_opener(
                urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()),
                upgrade.NoRedirect(),
            )
        client = self.clients[actor]
        headers = {
            "Accept": "text/html",
            "Accept-Encoding": "identity",
            "Sec-Fetch-Site": "same-origin",
            "Origin": self.base,
        } | (headers or {})
        request = urllib.request.Request(
            self.base + path, data=body, headers=headers, method=method
        )
        try:
            response = client.open(request, timeout=10)
        except urllib.error.HTTPError as error:
            response = error
        with response:
            data = response.read()
            length = response.headers.get("Content-Length")
            if length is not None and method != "HEAD" and response.status != 304:
                assert len(data) == int(length), (
                    "incomplete response",
                    len(data),
                    length,
                )
            location = urllib.parse.urlsplit(response.headers.get("Location", ""))
            destination = location.path + (
                "?" + location.query if location.query else ""
            )
            self.trace.append(
                {
                    "actor": actor,
                    "method": method,
                    "path": path,
                    "status": response.status,
                    "location": destination,
                    "frame": headers.get("Turbo-Frame"),
                }
            )
            return response.status, destination, response.headers, data

    def login(self, actor):
        return self.request(
            actor,
            "POST",
            "/session",
            {
                "email_address": self.labels["emails." + actor],
                "password": self.labels["passwords.all"],
            },
        )

    def rows(self, query, args=()):
        with sqlite3.connect(f"file:{self.database}?mode=ro", uri=True) as db:
            return db.execute(query, args).fetchall()


def authentication(app):
    room = app.labels["rooms.hq"]
    status, location, _ = app.request("david", "GET", f"/rooms/{room}")
    assert (status, location) == (302, "/session/new"), (status, location)
    status, location, _ = app.login("david")
    assert (status, location) == (302, f"/rooms/{room}"), (status, location)
    assert app.request("david", "GET", f"/rooms/{room}")[0] == 200
    status, _, body = app.request("david", "GET", "/session/new")
    assert status == 200 and 'name="password"' in body, ("signed-in login form", status)
    status, _, _ = app.request(
        "david",
        "POST",
        "/session",
        {
            "email_address": app.labels["emails.kevin"],
            "password": app.labels["passwords.all"],
        },
    )
    assert status == 302
    assert (
        app.labels["emails.kevin"]
        in app.request("david", "GET", "/users/me/profile")[2]
    )
    assert app.request("david", "DELETE", "/session", {})[:2] == (302, "/")
    assert app.request("david", "GET", f"/rooms/{room}")[:2] == (302, "/session/new")


def direct_ping(app):
    assert app.login("david")[0] == 302
    for frame in (None, "direct_rooms_control"):
        status, _, body = app.request("david", "GET", "/rooms/directs/new", frame=frame)
        assert (
            status == 200
            and 'name="user_ids[]"' in body
            and 'href="/users/me/sidebar"' in body
        )
    rooms_before = app.rows("SELECT count(*) FROM rooms")[0][0]
    target = f"/rooms/{app.labels['rooms.david_and_kevin']}"
    missing = app.rows("SELECT max(id)+1 FROM users")[0][0]
    users = app.labels["users.kevin"], app.labels["users.david"]
    for selected in ([users[0]], [users[1], users[0], users[0]], [users[0], missing]):
        fields = [("user_ids[]", user) for user in selected]
        status, location, _ = app.request("david", "POST", "/rooms/directs", fields)
        assert (status, location) == (302, target), (selected, status, location, target)
        assert app.rows("SELECT count(*) FROM rooms")[0][0] == rooms_before


def message_ids(body):
    return [int(value) for value in re.findall(r'data-message-id="([0-9]+)"', body)]


def pagination(app):
    assert app.login("david")[0] == 302
    room, anchor = app.labels["rooms.watercooler"], app.labels["messages.busy_060"]
    expected = [
        row[0]
        for row in app.rows(
            "SELECT id FROM messages WHERE room_id=? ORDER BY created_at", (room,)
        )
    ]
    created = app.rows("SELECT created_at FROM messages WHERE id=?", (anchor,))[0][0]
    for direction, operator, reverse in (("before", "<", True), ("after", ">", False)):
        ids = [
            row[0]
            for row in app.rows(
                f"SELECT id FROM messages WHERE room_id=? AND created_at {operator} ? ORDER BY created_at {'DESC' if reverse else 'ASC'} LIMIT 40",
                (room, created),
            )
        ]
        if reverse:
            ids.reverse()
        status, _, body = app.request(
            "david", "GET", f"/rooms/{room}/messages?{direction}={anchor}"
        )
        assert status == 200 and message_ids(body) == ids, (
            direction,
            status,
            message_ids(body),
            ids,
        )
        foreign = app.labels["messages.plain"]
        status, _, _ = app.request(
            "david", "GET", f"/rooms/{room}/messages?{direction}={foreign}"
        )
        assert status == 404, ("foreign cursor", direction, status)
    status, _, body = app.request("david", "GET", f"/rooms/{room}/messages")
    assert status == 200 and message_ids(body) == expected[-40:]
    empty = app.labels["rooms.pets"]
    status, _, body = app.request("david", "GET", f"/rooms/{empty}/messages")
    assert status == 204 and body == "", (status, body)


def sidebar(app):
    assert app.login("david")[0] == 302
    for frame in (None, "user_sidebar"):
        status, _, body = app.request("david", "GET", "/users/me/sidebar", frame=frame)
        assert status == 200 and "<html" in body and "<body" in body
        assert 'id="user_sidebar"' in body and 'id="direct_rooms_control"' in body
        assert ("<!DOCTYPE html>" in body) == (frame is None)
        assert ('name="current-user-id"' in body) == (frame is None)


def message_lifecycle(app):
    assert app.login("kevin")[0] == 302
    assert app.login("jz")[0] == 302
    room = app.labels["rooms.hq"]
    route = f"/rooms/{room}/messages"
    client = "contract-message-client"
    old, new = "contractneedlealpha", "contractneedlebeta"
    status, _, body = app.request(
        "kevin",
        "POST",
        route,
        {"message[body]": f"<p>{old}</p>", "message[client_message_id]": client},
    )
    assert status == 200 and 'action="append"' in body
    stored = app.rows(
        "SELECT id,creator_id FROM messages WHERE client_message_id=?", (client,)
    )
    assert len(stored) == 1 and stored[0][1] == app.labels["users.kevin"], stored
    message = stored[0][0]
    path = route + f"/{message}"
    for method, suffix, fields in (
        ("GET", "/edit", None),
        ("PATCH", "", {"message[body]": "forbidden"}),
        ("DELETE", "", {}),
    ):
        assert app.request("jz", method, path + suffix, fields)[0] == 403
    status, _, body = app.request("kevin", "GET", path + "/edit")
    assert status == 200 and 'name="message[body]"' in body and 'value="patch"' in body
    assert app.request("kevin", "GET", path)[0] == 200
    # Warm the reads before mutation: a stale result cache cannot pass this flow.
    for route in (f"/rooms/{room}", path, f"/searches?q={old}"):
        assert old in app.request("kevin", "GET", route)[2]
    assert app.request("kevin", "PATCH", path, {"message[body]": f"<p>{new}</p>"})[
        :2
    ] == (302, path)
    for route in (f"/rooms/{room}", path, f"/searches?q={new}"):
        assert new in app.request("kevin", "GET", route)[2]
    assert message not in message_ids(
        app.request("kevin", "GET", f"/searches?q={old}")[2]
    )
    assert app.rows(
        "SELECT rowid FROM message_search_index WHERE message_search_index MATCH ?",
        (new,),
    ) == [(message,)]
    assert app.request("kevin", "DELETE", path, {})[0] == 200
    assert app.rows("SELECT id FROM messages WHERE id=?", (message,)) == []
    assert (
        app.rows(
            "SELECT id FROM action_text_rich_texts WHERE record_type='Message' AND record_id=?",
            (message,),
        )
        == []
    )
    assert (
        app.rows("SELECT rowid FROM message_search_index WHERE rowid=?", (message,))
        == []
    )
    assert app.request("kevin", "GET", path)[0] == 404


def room_membership(app):
    for actor in ("david", "kevin", "jz"):
        assert app.login(actor)[0] == 302
    david, kevin = (app.labels["users." + actor] for actor in ("david", "kevin"))
    original, private, reopened = (
        "Contract shared room",
        "Contract private room",
        "Contract reopened room",
    )
    needle = "contractroommembershipneedle"
    status, location, _ = app.request(
        "david", "POST", "/rooms/opens", {"room[name]": original}
    )
    assert status == 302 and re.fullmatch(r"/rooms/\d+", location), (status, location)
    room = int(location.rsplit("/", 1)[1])
    members = lambda: app.rows(
        "SELECT user_id FROM memberships WHERE room_id=? ORDER BY user_id", (room,)
    )
    active = app.rows("SELECT id FROM users WHERE status=0 ORDER BY id")
    assert members() == active
    status, _, _ = app.request(
        "david",
        "POST",
        location + "/messages",
        {
            "message[body]": needle,
            "message[client_message_id]": "contract-room-member-client",
        },
    )
    assert status == 200
    message = app.rows(
        "SELECT id FROM messages WHERE client_message_id='contract-room-member-client'"
    )[0][0]
    for actor in ("kevin", "jz"):
        assert needle in app.request(actor, "GET", location)[2]
        assert message in message_ids(
            app.request(actor, "GET", f"/searches?q={needle}")[2]
        )
        assert original in app.request(actor, "GET", "/users/me/sidebar")[2]
    assert (
        app.request(
            "kevin", "PATCH", f"/rooms/opens/{room}", {"room[name]": "forbidden"}
        )[0]
        == 403
    )
    assert app.rows("SELECT name FROM rooms WHERE id=?", (room,)) == [(original,)]
    assert members() == active
    fields = [
        ("room[name]", private),
        ("user_ids[]", david),
        ("user_ids[]", kevin),
        ("user_ids[]", kevin),
        ("user_ids[]", -1),
    ]
    assert app.request("david", "PATCH", f"/rooms/closeds/{room}", fields)[:2] == (
        302,
        location,
    )
    assert app.rows("SELECT type,name FROM rooms WHERE id=?", (room,)) == [
        ("Rooms::Closed", private)
    ]
    assert members() == sorted([(david,), (kevin,)])
    assert needle in app.request("kevin", "GET", location)[2]
    assert private in app.request("kevin", "GET", "/users/me/sidebar")[2]
    for path in (location, f"/rooms/closeds/{room}", f"/rooms/closeds/{room}/edit"):
        assert app.request("jz", "GET", path)[:2] == (302, "/"), ("revoked room", path)
    for namespace in ("opens", "closeds"):
        result = app.request(
            "jz", "PATCH", f"/rooms/{namespace}/{room}", {"room[name]": "revoked write"}
        )
        assert result[:2] == (302, "/"), ("revoked update", namespace, result[:2])
    assert app.rows("SELECT name FROM rooms WHERE id=?", (room,)) == [(private,)]
    assert message not in message_ids(
        app.request("jz", "GET", f"/searches?q={needle}")[2]
    )
    assert private not in app.request("jz", "GET", "/users/me/sidebar")[2]
    assert app.request("jz", "GET", location + "/messages")[0] == 404
    result = app.request(
        "jz", "POST", location + "/messages", {"message[body]": "revoked write"}
    )
    assert result[0] == 200 and "This room was deleted." in result[2]
    assert app.rows("SELECT id FROM messages WHERE room_id=?", (room,)) == [(message,)]
    assert app.request(
        "david", "PATCH", f"/rooms/opens/{room}", {"room[name]": reopened}
    )[:2] == (302, location)
    assert members() == active
    assert needle in app.request("jz", "GET", location)[2]
    assert reopened in app.request("jz", "GET", "/users/me/sidebar")[2]
    assert message in message_ids(app.request("jz", "GET", f"/searches?q={needle}")[2])
    direct = app.labels["rooms.david_and_kevin"]
    assert app.request(
        "david", "PATCH", f"/rooms/opens/{direct}", {"room[name]": "not shared"}
    )[:2] == (302, "/")
    assert app.rows("SELECT type FROM rooms WHERE id=?", (direct,)) == [
        ("Rooms::Direct",)
    ]
    assert app.request("david", "DELETE", location, {})[:2] == (302, "/")
    for query in (
        "SELECT id FROM rooms WHERE id=?",
        "SELECT id FROM messages WHERE room_id=?",
        "SELECT user_id FROM memberships WHERE room_id=?",
    ):
        assert app.rows(query, (room,)) == []
    assert (
        app.rows("SELECT rowid FROM message_search_index WHERE rowid=?", (message,))
        == []
    )


def allocate_blob(app, content, filename, content_type, form=False):
    fields = {
        "filename": filename,
        "content_type": content_type,
        "byte_size": len(content),
        "checksum": base64.b64encode(hashlib.md5(content).digest()).decode(),
    }
    body = (
        urllib.parse.urlencode(
            {f"blob[{key}]": value for key, value in fields.items()}
        ).encode()
        if form
        else json.dumps({"blob": fields}).encode()
    )
    status, _, _, data = app.fetch(
        "kevin",
        "POST",
        "/rails/active_storage/direct_uploads",
        body,
        {
            "Content-Type": "application/x-www-form-urlencoded"
            if form
            else "application/json",
            "Accept": "application/json",
        },
    )
    assert status == 200, ("allocate", form, status, data)
    blob = json.loads(data)
    uploaded = urllib.parse.urlsplit(blob["direct_upload"]["url"])
    assert (uploaded.scheme, uploaded.netloc) == (
        urllib.parse.urlsplit(app.base).scheme,
        urllib.parse.urlsplit(app.base).netloc,
    )
    blob["upload_path"] = uploaded.path
    blob["proxy_path"] = (
        f"/rails/active_storage/blobs/proxy/{blob['signed_id']}/{filename}"
    )
    assert app.rows(
        "SELECT filename,content_type,byte_size,checksum FROM active_storage_blobs WHERE id=?",
        (blob["id"],),
    ) == [tuple(fields.values())]
    assert (
        app.rows(
            "SELECT id FROM active_storage_attachments WHERE blob_id=?", (blob["id"],)
        )
        == []
    )
    return blob


def direct_upload(app):
    assert app.login("kevin")[0] == 302
    content = b"0123456789"
    for form in (False, True):
        blob = allocate_blob(app, content, "audit.png", "image/png", form)
        file = (
            app.database.parent
            / "files"
            / blob["key"][:2]
            / blob["key"][2:4]
            / blob["key"]
        )
        assert not file.exists()
        status, _, headers, _ = app.fetch("public", "GET", blob["proxy_path"])
        assert status == 404 and "no-cache" in headers.get("Cache-Control", ""), (
            "unwritten download",
            status,
            dict(headers),
        )
        for body, mime_type in (
            (content, "text/plain"),
            (content[:-1], "image/png"),
            (b"abcdefghij", "image/png"),
        ):
            result = app.fetch(
                "kevin", "PUT", blob["upload_path"], body, {"Content-Type": mime_type}
            )
            assert result[0] == 422, ("invalid upload", result[0])
            assert not file.exists()
        assert (
            app.fetch(
                "kevin",
                "PUT",
                blob["upload_path"],
                content,
                blob["direct_upload"]["headers"],
            )[0]
            == 204
        )
        assert file.read_bytes() == content
        status, _, headers, body = app.fetch("public", "GET", blob["proxy_path"])
        assert (
            status == 200
            and body == content
            and "immutable" in headers.get("Cache-Control", "")
        )
    cookies = next(
        handler.cookiejar
        for handler in app.clients["kevin"].handlers
        if isinstance(handler, urllib.request.HTTPCookieProcessor)
    )
    retained = "; ".join(f"{cookie.name}={cookie.value}" for cookie in cookies)
    assert retained
    assert app.request("kevin", "DELETE", "/session", {})[0] == 302
    assert (
        app.fetch(
            "stale",
            "PUT",
            blob["upload_path"],
            content,
            {"Cookie": retained, "Content-Type": "image/png"},
        )[0]
        == 401
    )
    count = app.rows("SELECT count(*) FROM active_storage_blobs")
    assert (
        app.fetch(
            "stale",
            "POST",
            "/rails/active_storage/direct_uploads",
            b"{}",
            {"Cookie": retained, "Content-Type": "application/json"},
        )[0]
        == 401
    )
    assert (
        app.rows("SELECT count(*) FROM active_storage_blobs") == count
        and file.read_bytes() == content
    )
    assert app.fetch("public", "GET", blob["proxy_path"])[3] == content


def storage_downloads(app):
    assert app.login("kevin")[0] == 302
    content = b"0123456789"
    blob = allocate_blob(app, content, "audit.png", "image/png")
    assert (
        app.fetch(
            "kevin",
            "PUT",
            blob["upload_path"],
            content,
            blob["direct_upload"]["headers"],
        )[0]
        == 204
    )
    redirect = blob["proxy_path"].replace("/proxy/", "/redirect/")
    status, disk, _, _ = app.fetch("public", "GET", redirect)
    assert status == 302
    for path, proxy in (
        (disk, False),
        (blob["proxy_path"] + "?disposition=attachment", True),
    ):
        status, _, headers, body = app.fetch(
            "public", "GET", path, headers={"Range": "bytes=1-2"}
        )
        assert (
            status == 206
            and body == b"12"
            and headers["Content-Range"] == "bytes 1-2/10"
        )
        if proxy:
            assert headers["Content-Disposition"].startswith("inline;"), (
                "ranged disposition",
                headers["Content-Disposition"],
            )
        head = app.fetch("public", "HEAD", path, headers={"Range": "bytes=1-2"})
        assert (
            head[0] == 206
            and head[3] == b""
            and head[2]["Content-Range"] == headers["Content-Range"]
            and head[2]["Content-Length"] == "2"
        )
        status, _, headers, body = app.fetch(
            "public", "GET", path, headers={"Range": "bytes=99-"}
        )
        assert status == 416 and body == (
            b"" if proxy else b"Byte range unsatisfiable\n"
        )
        if not proxy:
            assert headers["Content-Range"] == "bytes */10"
        response = app.fetch("public", "GET", path)
        key, value = (
            ("If-None-Match", response[2]["ETag"])
            if proxy
            else ("If-Modified-Since", response[2]["Last-Modified"])
        )
        conditional = app.fetch("public", "GET", path, headers={key: value})
        assert conditional[0] == 304 and conditional[3] == b""
    room = app.labels["rooms.designers"]
    body = app.request("kevin", "GET", f"/rooms/{room}")[2]
    representation = re.search(
        r'(?:src|href)="([^"]*/rails/active_storage/representations/redirect/[^"]+)"',
        body,
    )
    assert representation, "missing seeded image representation"
    path = representation[1].removeprefix(app.base)
    path = path.replace("/redirect/", "/proxy/") + "?disposition=attachment"
    status, _, headers, full = app.fetch("public", "GET", path)
    assert (
        status == 200
        and full
        and headers["Content-Disposition"].startswith("attachment;")
    ), ("representation", status, dict(headers))
    status, _, ranged, data = app.fetch(
        "public", "GET", path, headers={"Range": "bytes=0-1"}
    )
    assert status == 200 and data == full and not ranged.get("Content-Range"), (
        "ranged representation",
        status,
        len(data),
        len(full),
    )
    response = app.fetch(
        "public",
        "GET",
        path,
        headers={"Range": "bytes=99-", "If-None-Match": headers["ETag"]},
    )
    assert response[0] == 304 and response[3] == b""


WORKFLOWS = {
    "authentication": authentication,
    "direct_ping": direct_ping,
    "pagination": pagination,
    "sidebar": sidebar,
    "message_lifecycle": message_lifecycle,
    "room_membership": room_membership,
    "direct_upload": direct_upload,
    "storage_downloads": storage_downloads,
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rust-root", type=Path, default=ROOT / "reference")
    parser.add_argument("--seed", type=Path, required=True)
    parser.add_argument("--go-binary", type=Path, default=ROOT / "campfire")
    parser.add_argument("--rust-binary", type=Path, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--only", choices=WORKFLOWS, nargs="+", default=list(WORKFLOWS))
    args = parser.parse_args()
    args.out.mkdir(parents=True, exist_ok=False)
    labels = json.loads((args.seed / "labels.json").read_text())
    env = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith(("CAMPFIRE_", "THRUSTER_")) and key != "TLS_DOMAIN"
    }
    for line in (args.rust_root / "parity/.env.reference").read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            env[key] = value
    env.update(
        DISABLE_SSL="true",
        TARGET_BIND="127.0.0.1",
        GOMAXPROCS="4",
        TOKIO_WORKER_THREADS="4",
    )
    binaries = {"rust": args.rust_binary.resolve(), "go": args.go_binary.resolve()}
    report = {
        "scope": "Functional HTTP and persisted-state contracts, not exact HTML or JavaScript parity",
        "binaries": {
            name: hashlib.sha256(binary.read_bytes()).hexdigest()
            for name, binary in binaries.items()
        },
        "tool_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "labels_sha256": hashlib.sha256(
            (args.seed / "labels.json").read_bytes()
        ).hexdigest(),
        "runs": [],
    }
    failed = False
    for name in args.only:
        for implementation, binary in binaries.items():
            with tempfile.TemporaryDirectory(
                prefix="contract-", dir=args.out
            ) as temporary:
                work = Path(temporary)
                database = work / "database.sqlite3"
                with (
                    sqlite3.connect(
                        f"file:{args.seed}/db/production.sqlite3?mode=ro", uri=True
                    ) as source,
                    sqlite3.connect(database) as destination,
                ):
                    source.backup(destination)
                shutil.copytree(args.seed / "storage", work / "files")
                environment = env | {
                    "CAMPFIRE_DATABASE_PATH": str(database),
                    "CAMPFIRE_STORAGE_PATH": str(work),
                    "CAMPFIRE_FILES_PATH": str(work / "files"),
                }
                result = {
                    "workflow": name,
                    "implementation": implementation,
                    "seed_snapshot_sha256": hashlib.sha256(
                        database.read_bytes()
                    ).hexdigest(),
                }
                with upgrade.server(
                    binary, environment, args.out, implementation + "-" + name
                ) as base:
                    app = App(base, database, labels)
                    try:
                        WORKFLOWS[name](app)
                        result["pass"] = True
                    except (AssertionError, urllib.error.URLError) as error:
                        result.update(
                            {
                                "pass": False,
                                "error": str(error) or "contract assertion failed",
                            }
                        )
                        failed = True
                    result["requests"] = app.trace
                report["runs"].append(result)
                print(
                    implementation,
                    name,
                    "PASS" if result["pass"] else "FAIL: " + result["error"],
                    flush=True,
                )
                (args.out / "report.json").write_text(
                    json.dumps(report, indent=2) + "\n"
                )
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
